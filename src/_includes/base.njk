    posthog.init('{{ env.posthogToken }}', {
        api_host: '{{ env.posthogHost }}',
        defaults: '2026-05-30',
        person_profiles: 'identified_only', // or 'always' to create profiles for anonymous users as well
    })
  </script>
  {%- endif %}
</head>
<body>

<a class="skip-link" href="#main">Skip to content</a>

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-logo">
      <svg class="site-logo__seal" viewBox="0 0 34 34" aria-hidden="true" focusable="false">
        <circle cx="17" cy="17" r="15.5" fill="none" stroke="currentColor" stroke-width="1.5" />
        <circle cx="17" cy="17" r="8" fill="none" stroke="currentColor" stroke-width="1.5" />
        <circle cx="17" cy="4.5" r="1.9" /><circle cx="29.5" cy="17" r="1.9" />
        <circle cx="17" cy="29.5" r="1.9" /><circle cx="4.5" cy="17" r="1.9" />
      </svg>
      <span class="site-logo__wm">drum<em>.town</em></span>
    </a>
    {#- Current-section highlight. Lesson pages pass navSection (foundations |
        track | mastery); everything else is derived from the URL. -#}
    {%- set sec = navSection or (
          'track' if '/genres/' in page.url else (
          'rudiments' if '/rudiments/' in page.url else (
          'metronome' if '/metronome/' in page.url else ''))) %}
    <nav class="site-nav" id="site-nav" aria-label="Site">
      <a href="/#foundations"{% if sec == 'foundations' %} class="active" aria-current="true"{% endif %}>Foundations</a>
      <a href="/#tracks"{% if sec == 'track' %} class="active" aria-current="true"{% endif %}>Genres</a>
      <a href="/#mastery"{% if sec == 'mastery' %} class="active" aria-current="true"{% endif %}>Other Topics</a>
      <a href="/rudiments/"{% if sec == 'rudiments' %} class="active" aria-current="page"{% endif %}>Rudiments</a>
      <a href="/metronome/"{% if sec == 'metronome' %} class="active" aria-current="page"{% endif %}>Metronome</a>
    </nav>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch to dark theme">
      <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="4.6" fill="none" stroke="currentColor" stroke-width="1.8" />
        <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M12 2.4v2.6M12 19v2.6M2.4 12h2.6M19 12h2.6M5.2 5.2l1.9 1.9M16.9 16.9l1.9 1.9M18.8 5.2l-1.9 1.9M7.1 16.9l-1.9 1.9" />
        </g>
      </svg>
      <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M20.5 14.6A8.6 8.6 0 1 1 9.4 3.5a7 7 0 0 0 11.1 11.1z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
      </svg>
    </button>
    {#- Collapsed state of the transport dock (system.md §3/§7). Live BPM and
        time signature are written here by metronome.js; the dot pulses with
        the beat so a running metronome is never hidden. -#}
    <button class="clock-pill" id="metronome-pill" type="button" aria-expanded="false" aria-controls="site-metronome">
      <span class="clock-pill__dot" aria-hidden="true">▶</span>
      <b class="clock-pill__bpm" aria-hidden="true">80</b><small class="clock-pill__sig" aria-hidden="true">· 4/4</small>
      {#- The whole accessible name lives in this one span rather than being
          concatenated from the visible parts: nothing separates <b> from the
          span in the rendered markup, so a composed name would run together as
          "80beats per minute". metronome.js rewrites the tempo and the running
          word here; open/closed is carried by aria-expanded, not by this text.
          The static wording below is the no-JS fallback. -#}
      <span class="sr-only" id="metronome-pill-state">Metronome, 80 beats per minute, stopped</span>
    </button>
    <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" aria-label="Menu">
      <span class="nav-toggle__bars" aria-hidden="true"></span>
    </button>
  </div>
</header>

<main id="main">
{{ content | safe }}
</main>

<footer class="site-footer">
  <a href="/">Curriculum</a> · <a href="/rudiments/">Rudiments</a> · <a href="/metronome/">Metronome</a> · <a href="https://github.com/dylanpjenkins/drum-town">GitHub</a>
  <br />Notation rendered with VexFlow at build time
</footer>

{#- Transport dock (system.md §7). Ships collapsed so no dock flashes open
    before metronome.js runs; the header clock pill expands it. Control IDs are
    unchanged from the old floating card — metronome.js keeps its wiring. -#}
<aside class="transport is-collapsed" id="site-metronome" aria-label="Metronome">
  <div class="transport__row">
    <button class="transport__go" id="metronome-toggle" type="button" aria-label="Start metronome">
      <span class="transport__icon" aria-hidden="true">▶</span>
    </button>
    <label class="transport__bpm-wrap">
      <input type="number" class="transport__bpm" id="metronome-bpm" value="80" min="30" max="240" step="1" aria-label="Tempo in beats per minute" />
      <span class="transport__bpm-label" aria-hidden="true">BPM</span>
    </label>
    <input type="range" class="transport__slider" id="metronome-slider" min="30" max="240" step="1" value="80" aria-label="Tempo slider" />
    <select class="transport__timesig" id="metronome-timesig" aria-label="Beats per bar">
      <option value="2">2/4</option>
      <option value="3">3/4</option>
      <option value="4" selected>4/4</option>
      <option value="5">5/4</option>
      <option value="6">6/8</option>
      <option value="7">7/8</option>
    </select>
    <div class="transport__beats" id="metronome-beats" aria-hidden="true"></div>
    <span class="transport__vol">
      <span class="transport__vol-icon" aria-hidden="true">♪</span>
      <input type="range" class="transport__volume" id="metronome-volume" min="0" max="100" step="1" value="60" aria-label="Volume" />
    </span>
    <button class="transport__collapse" id="metronome-collapse" type="button" aria-expanded="true" aria-label="Collapse metronome">▾</button>
  </div>
</aside>

<script src="/assets/js/chrome.js" defer></script>
<script src="/assets/js/progress.js" defer></script>
<script src="/assets/js/pattern-math.js" defer></script>
<script src="/assets/js/player.js" defer></script>
<script src="/assets/js/metronome.js" defer></script>

</body>
</html>
