---
layout: base.njk
---

<div class="container container--wide">

  {# ======================  HERO  ======================
     One hero, always the thesis. The returning-visitor state is carried by
     the second CTA (#cta-continue), which the activation script at the
     bottom of this file fills in and unhides; a first-time visitor sees
     exactly one call to action. #}
  <section class="hero">
    <p class="eyebrow">drum.town · a free town for learning the drums</p>
    <h1>The whole town practices to the same <em>clock.</em></h1>
    <p class="hero__dek">A complete curriculum you can walk: <strong>{{ curriculum | lessonCount }} lessons</strong> with real notation you can press play on, <strong>{{ lessonContent | exerciseCount }} exercises</strong>, <strong>40 rudiments</strong> — free, in your browser, no sign-up.</p>
    <div class="hero__actions">
      <a class="btn btn--primary" href="/lessons/{{ curriculum.foundations.sections[0].lessons[0].slug }}/">Start here — your first lesson <span aria-hidden="true">→</span></a>
      <a class="btn btn--ghost" id="cta-continue" href="#" hidden>Continue — <span data-slot="title"></span> <span aria-hidden="true">→</span></a>
    </div>
    <p class="hero__honesty"><strong>The town remembers.</strong> Your progress lives in this browser — no account, nothing to join.</p>
    {#- Two different end states. The positional one fires whenever the last
        lesson you opened has nothing after it, which can happen on your very
        first visit if you land on the final lesson from search. Only the second
        may claim you finished anything. -#}
    <p class="hero__honesty" id="hero-end-msg" hidden>That's the last stop on the walk. <a href="https://github.com/dylanpjenkins/drum-town/issues">What should the town build next? →</a></p>
    <p class="hero__honesty" id="hero-completed-msg" hidden>You've walked every street in town. <a href="https://github.com/dylanpjenkins/drum-town/issues">What should the town build next? →</a></p>
  </section>

  <p class="ledger-legend">✓ streets you've walked · ● you are here · ○ still to visit</p>

  {# ======================  THE LEDGER  ======================
     One .ledger section per chapter: eleven Foundations sub-sections, then
     one per genre track, then a final "Other Topics" chapter. Section
     anchors (#foundations, #tracks, #mastery) live on the first chapter of
     each group so the site nav keeps working. #}

  {% set foundationsCount = curriculum.foundations.sections.length %}
  {% set tracksCount = curriculum.tracks.length %}
  {% set chapterTotal = foundationsCount + tracksCount + 1 %}

  {% for sec in curriculum.foundations.sections %}
    <section class="ledger"{% if loop.first %} id="foundations"{% endif %}>
      <header class="ledger__head">
        <span class="ledger__kicker">Chapter {{ loop.index }} of {{ chapterTotal }}</span>
        <h2 class="ledger__title">{{ sec.title }}</h2>
        <span class="ledger__count">{{ sec.lessons.length }} lessons</span>
      </header>
      {% if sec.tagline %}<p class="ledger__tagline">{{ sec.tagline }}</p>{% endif %}
      <ol class="ledger__rows">
        {% for lesson in sec.lessons %}
          <li><a class="ledger-row" href="/lessons/{{ lesson.slug }}/">
            <span class="ledger-row__num">{{ loop.index | pad2 }}</span>
            <span class="ledger-row__title">{{ lesson.title }}</span>
            <span class="ledger-row__leader" aria-hidden="true"></span>
            <span class="ledger-row__meta"><span class="ledger-row__min">{{ lessonContent[lesson.slug].duration }}</span><span class="ledger-row__mark" aria-hidden="true"></span></span>
          </a></li>
        {% endfor %}
      </ol>
    </section>
  {% endfor %}

  {% for track in curriculum.tracks %}
    {% set trackLessons = track | flatTrackLessons %}
    <section class="ledger"{% if loop.first %} id="tracks"{% endif %}>
      <header class="ledger__head">
        <span class="ledger__kicker">Chapter {{ foundationsCount + loop.index }} of {{ chapterTotal }}</span>
        <h2 class="ledger__title">{{ track.title }}</h2>
        <span class="ledger__count">{{ trackLessons.length }} lessons</span>
      </header>
      {% if track.tagline %}<p class="ledger__tagline">{{ track.tagline }}</p>{% endif %}
      <ol class="ledger__rows">
        {% for lesson in trackLessons %}
          <li><a class="ledger-row" href="/lessons/{{ lesson.slug }}/">
            <span class="ledger-row__num">{{ loop.index | pad2 }}</span>
            <span class="ledger-row__title">{{ lesson.title }}</span>
            <span class="ledger-row__leader" aria-hidden="true"></span>
            <span class="ledger-row__meta"><span class="ledger-row__min">{{ lessonContent[lesson.slug].duration }}</span><span class="ledger-row__mark" aria-hidden="true"></span></span>
          </a></li>
        {% endfor %}
      </ol>
    </section>
  {% endfor %}

  <section class="ledger" id="mastery">
    <header class="ledger__head">
      <span class="ledger__kicker">Chapter {{ chapterTotal }} of {{ chapterTotal }}</span>
      <h2 class="ledger__title">Other Topics</h2>
      <span class="ledger__count">{{ curriculum.mastery.lessons.length }} lessons</span>
    </header>
    {% if curriculum.mastery.tagline %}<p class="ledger__tagline">{{ curriculum.mastery.tagline }}</p>{% endif %}
    <ol class="ledger__rows">
      {% for lesson in curriculum.mastery.lessons %}
        <li><a class="ledger-row" href="/lessons/{{ lesson.slug }}/">
          <span class="ledger-row__num">{{ loop.index | pad2 }}</span>
          <span class="ledger-row__title">{{ lesson.title }}</span>
          <span class="ledger-row__leader" aria-hidden="true"></span>
          <span class="ledger-row__meta"><span class="ledger-row__min">{{ lessonContent[lesson.slug].duration }}</span><span class="ledger-row__mark" aria-hidden="true"></span></span>
        </a></li>
      {% endfor %}
    </ol>
  </section>

</div>

{# ======================  EMBEDDED DATA + ACTIVATION  ====================== #}
<script type="application/json" id="lessons-data">{{ lessonsData | inlineJson | safe }}</script>

<script>
  (function () {
    function ready(fn) {
      if (window.DCProgress) { fn(); return; }
      document.addEventListener('DOMContentLoaded', fn, { once: true });
    }

    ready(function () {
      if (!window.DCProgress) return;
      var dataEl = document.getElementById('lessons-data');
      if (!dataEl) return;
      var data;
      try { data = JSON.parse(dataEl.textContent); } catch (e) { return; }

      var last = DCProgress.getLastVisited();

      var visited = DCProgress.getVisited();
      var visitedSet = {};
      for (var i = 0; i < visited.length; i++) visitedSet[visited[i]] = true;

      // The ✓/● marks are CSS ::before content on an aria-hidden span, so the
      // state has to be spoken separately or a screen reader hears nothing.
      function announce(row, text) {
        var s = document.createElement('span');
        s.className = 'sr-only';
        s.textContent = text;
        row.appendChild(s);
      }

      var rows = document.querySelectorAll('.ledger-row');
      for (var j = 0; j < rows.length; j++) {
        var href = rows[j].getAttribute('href') || '';
        var m = href.match(/\/lessons\/([^\/]+)\/?$/);
        if (!m) continue;
        var slug = m[1];
        if (visitedSet[slug]) rows[j].classList.add('is-visited');
        if (slug === last) rows[j].classList.add('is-last-visited');
        // "here" supersedes "visited" — the last-visited row always carries
        // both classes, and announcing both would read as a stutter.
        if (slug === last) announce(rows[j], 'current lesson');
        else if (visitedSet[slug]) announce(rows[j], 'visited');
      }

      if (!last) return;

      var order = data.order || [];
      var idx = order.indexOf(last);
      if (idx === -1) return;

      if (idx === order.length - 1) {
        // Reaching the last lesson is a POSITION, not an achievement. Someone
        // who lands on the final lesson from a search result and clicks the
        // logo has visited exactly one thing; telling them they had finished
        // every lesson was false, and sat two lines under a button still
        // reading "Start here — your first lesson".
        var walkedAll = order.length > 0 && order.every(function (s) { return visited.indexOf(s) !== -1; });
        var msg = document.getElementById(walkedAll ? 'hero-completed-msg' : 'hero-end-msg');
        if (msg) msg.hidden = false;
        return;
      }

      var nextSlug = order[idx + 1];
      var lesson = (data.bySlug || {})[nextSlug];
      if (!lesson) return;

      var cta = document.getElementById('cta-continue');
      if (!cta) return;
      var titleSlot = cta.querySelector('[data-slot="title"]');
      if (titleSlot) titleSlot.textContent = lesson.title;
      cta.setAttribute('href', lesson.url);
      cta.hidden = false;
    });
  })();
</script>
